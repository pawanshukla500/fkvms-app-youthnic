# ---------------------------------------------------------------------------
# Youthnic lookup backend
#
# This service is the only thing that touches Forward Scan, and it only reads.
# Packing desks never hold a connection string; they call this API over HTTP.
# ---------------------------------------------------------------------------

# Forward Scan database. Both drivers are supported, and the driver is chosen
# from the value itself.
#
# SQLite - what Forward Scan uses by default (its config.py falls back to
# sqlite:///omsguru_forward_scan.db). Give the absolute path to the same file
# the Forward Scan app opens. The handle is opened SQLITE_OPEN_READONLY, so
# writes are refused by SQLite itself.
#
#   VMS_DATABASE_URL=C:/Users/<you>/Desktop/Forward Scan Project/omsguru_forward_scan.db
#   VMS_DATABASE_URL=sqlite:////srv/forward-scan/omsguru_forward_scan.db
#
# PostgreSQL - use a role holding SELECT and nothing else. See DEPLOYMENT.md
# for the exact grants, and confirm with GET /api/readonly-audit.
#
#   VMS_DATABASE_URL=postgresql://vms_reader:<password>@<host>:5432/forward_scan
VMS_DATABASE_URL=

# TLS for PostgreSQL only. Ignored for SQLite.
#   verify     - require TLS and validate the certificate (recommended)
#   no-verify  - require TLS but skip validation (self-signed internal certs)
#   disable    - plain connection, only on a trusted private network
VMS_DATABASE_SSL=verify

# Abandon a query that takes longer than this. A scan lookup is a single
# indexed read, so anything slower means something is wrong.
VMS_DB_QUERY_TIMEOUT_MS=2000

# PostgreSQL pool size. A lookup service needs very few connections.
VMS_DB_POOL_MAX=5

# How long a resolved scan stays cached. Keep it short: Forward Scan syncs
# roughly every 5 minutes, so a parcel that was not found a moment ago should
# become findable soon after.
VMS_LOOKUP_CACHE_SECONDS=60

# Port the desks connect to.
LOOKUP_API_PORT=3100

# Leave empty for Electron desks, which send no Origin header. Only set this
# if you also open the API from a browser.
CORS_ALLOWED_ORIGINS=
