# ==============================================================
# YOUTHNIC PACKING DESK — environment reference
#
# This file documents every variable. It is committed; .env is not.
#
# Only the BACKEND reads these. Packing desks hold no database URL and no
# marketplace password in a file: their settings live in the setup wizard, and
# passwords go into Windows credential protection.
# ==============================================================

# --------------------------------------------------------------
# Forward Scan database (backend only)
# --------------------------------------------------------------
# Use a dedicated SELECT-only role. See DEPLOYMENT.md for the exact grants.
# This is a template, not a verified connection.
VMS_DATABASE_URL=postgresql://vms_reader:<READ_ONLY_PASSWORD>@<HOST>:5433/forward_scan

# TLS handling. One of: verify | no-verify | disable
# Leave unset to use the driver default, which suits a trusted internal network.
VMS_DATABASE_SSL=

# A scan must never wait on a slow query, so queries are cut off hard.
VMS_DB_QUERY_TIMEOUT_MS=2000

# Small pool: this service only answers lookups.
VMS_DB_POOL_MAX=5

# Repeat scans of the same parcel are served from memory for this long.
VMS_LOOKUP_CACHE_SECONDS=60

# --------------------------------------------------------------
# Backend API
# --------------------------------------------------------------
LOOKUP_API_PORT=3100

# Leave blank for desktop clients (Electron sends no Origin header).
# Set a comma-separated list only if a browser must call this API.
CORS_ALLOWED_ORIGINS=

# ==============================================================
# Configured in the desktop setup wizard, NOT here
# ==============================================================
# Per packing desk:
#   - Device ID and desk name
#   - Lookup backend URL (e.g. http://192.168.1.50:3100)
#   - Flipkart VMS URL, username, password, Feed ID
#   - Myntra VMS URL, username, password, Feed ID
#   - Seller accounts and their Forward Scan seller codes:
#       ETHNIC JUNCTION — Flipkart
#       ETHNIC JUNCTION — Myntra Youthnic
#       VB EXPORT — Myntra PPMP
#
# The known Flipkart test portal is https://fkvms.synlabs.io/
# Enter real credentials in the wizard on each authorized machine. Do not put
# them in this file and do not ship them inside the installer.
